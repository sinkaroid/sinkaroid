{
  "name": "sinkaroid",
  "version": "4.0.0-alpha",
  "description": "A general purpose Vue.js portfolio template.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.ts,.vue src mock",
    "fetch:repo": "bun run mock/getRepository.ts",
    "fetch:repo:sas": "bun run mock/getRepositorySAS.ts",
    "fetch:anime": "bun run mock/getAnime.ts",
    "fetch:manga": "bun run mock/getManga.ts",
    "fetch:steam": "bun run mock/getGame.ts",
    "typecheck": "tsc --noEmit",
    "build:fresh": "rm -rf dist && rm -rf node_modules && bun run build"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "bun-types": "^1.3.14",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "fast-xml-parser": "^4.5.1",
    "moment": "^2.30.1",
    "sass": "^1.83.0",
    "sharp": "^0.35.3",
    "vite": "^6.0.7"
  },
  "keywords": [
    "vuejs",
    "minimalist",
    "portfolio",
    "sinkaroid"
  ]
}
