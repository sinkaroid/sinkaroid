{
  "name": "sinkaroid",
  "version": "6.0.5-alpha",
  "description": "Vue portfolio template with minimalist-design in mind.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.ts,.vue src ci",
    "fetch:repo": "bun run ci/getRepository.ts",
    "fetch:repo:sas": "bun run ci/getRepositorySAS.ts",
    "fetch:anime": "bun run ci/getAnime.ts",
    "fetch:manga": "bun run ci/getManga.ts",
    "fetch:steam": "bun run ci/getGame.ts",
    "typecheck": "tsc --noEmit",
    "build:fresh": "rm -rf dist && rm -rf node_modules && bun run build"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "vue": "^3.5.13",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "bun-types": "^1.3.14",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "fast-xml-parser": "^5.10.1",
    "moment": "^2.30.1",
    "scathach-api": "^1.0.16",
    "sharp": "^0.35.3",
    "vite": "^8.1.5"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}