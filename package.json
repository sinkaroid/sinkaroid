{
  "name": "sinkaroid",
  "version": "3.0.3-dev",
  "description": "A general purpose Vue.js portfolio template.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue src",
    "fetch:repo": "node mock/getRepository.js",
    "fetch:mal": "node mock/getAnime.js && node mock/getManga.js",
    "build:fresh": "rm -rf dist && rm -rf node_modules && bun run build"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "fast-xml-parser": "^4.5.1",
    "moment": "^2.30.1",
    "sass": "^1.83.0",
    "vite": "^6.0.7"
  },
  "keywords": [
    "vuejs",
    "minimalist",
    "portfolio",
    "sinkaroid"
  ]
}
